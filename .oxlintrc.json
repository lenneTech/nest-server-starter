{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "env": {
    "browser": false,
    "node": true
  },
  "rules": {
    "eqeqeq": "warn",
    "no-console": ["warn", { "allow": ["warn", "error", "info", "debug", "trace", "time", "timeEnd", "group", "groupEnd"] }],
    "no-underscore-dangle": ["warn", {
      "allow": [
        "$__",
        "__args",
        "__schema",
        "__typename",
        "_authenticatedViaBetterAuth",
        "_bsontype",
        "_configSubject$",
        "_doNotCheckSecurityDeep",
        "_endMigration",
        "_frozenConfigSubject$",
        "_id",
        "_instance",
        "_model",
        "_objectAlreadyCheckedForRestrictions",
        "_startMigration",
        "_translations",
        "_typeTestConfigs"
      ],
      "allowAfterThis": true,
      "allowAfterThisConstructor": true
    }],
    "no-unused-vars": ["warn", {
      "argsIgnorePattern": "^_",
      "caughtErrors": "none",
      "varsIgnorePattern": "^_"
    }],
    "no-unused-expressions": "off",
    "@typescript-eslint/no-unused-expressions": ["warn", {
      "allowShortCircuit": true,
      "allowTernary": true
    }],
    "no-extraneous-class": "off",
    "no-new": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "import/no-unassigned-import": "off",
    "preserve-caught-error": "warn",

    // Type-aware rules (`oxlint --type-aware`, needs oxlint-tsgolint), as in NestJS 12's project template and in
    // @lenne.tech/nest-server. An un-awaited promise is the one defect here no other check sees: its rejection is
    // unhandled, and Node ends the process on that by default.
    "typescript/no-floating-promises": "error",
    // `--type-aware` also turns on every type-aware rule of the categories above. These are off because they cannot
    // work under `strict: false` (they answer "requires strictNullChecks" for every file) ...
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    "typescript/no-useless-default-assignment": "off",
    // ... or because they flag deliberate idioms of a non-strict codebase rather than defects (`as` casts,
    // `String(unknown)` in messages, framework methods passed by reference, role strings compared with RoleEnum
    // members). Same list as nest-server's .oxlintrc.json. Measured here 2026-10-26: 193 findings without it, all
    // from these rules, none a defect; 0 with it.
    "typescript/consistent-return": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-unnecessary-template-expression": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-unsafe-enum-comparison": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off"
  },
  "overrides": [
    {
      "files": ["**/migrate/cli/**", "**/migrate/migration-runner.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["tests/**"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
