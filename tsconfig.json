{
  "compilerOptions": {
    // ES module project ("type": "module"), as `nest new` generates since NestJS 12 (nest-server migration
    // guide 11.43.x -> 12.0.x §17): resolve and emit exactly like Node, `exports` maps included.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Each file must compile on its own (SWC loader, vitest). Flags a type in a decorated signature that
    // needs `import type` (TS1272).
    "isolatedModules": true,
    "declaration": true,
    "noImplicitAny": false,
    "removeComments": true,
    "noLib": false,
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowJs": true,
    "target": "es2022",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    // TypeScript 6 turns `strict` on by default; the starter is written non-strict
    // (nest-server migration guide 11.43.x -> 12.0.x §2). A no-op under TypeScript 5.9.
    "strict": false,
    "useDefineForClassFields": true,
    "types": ["vitest/globals"]
  },
  "exclude": ["node_modules", "dist"]
}
